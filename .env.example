# --- Sanity (base de données + tableau de bord) ---
# Identifiant du projet Sanity (visible sur https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret partagé avec le webhook Sanity pour mettre le site à jour instantanément
SANITY_REVALIDATE_SECRET=

# --- Adresse publique du site (pour le SEO / sitemap) ---
NEXT_PUBLIC_SITE_URL=https://www.t2c-engineering.com

# --- Formulaire de contact (envoi d'email via Resend, https://resend.com) ---
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire
CONTACT_TO=
# Adresse d'expédition (domaine vérifié dans Resend)
CONTACT_FROM=T2C Engineering <contact@t2c-engineering.com>
